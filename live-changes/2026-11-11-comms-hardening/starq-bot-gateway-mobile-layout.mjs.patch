+/**
+ * Mobile layout. Envelope values come only from the authenticated event and the broker
+ * decision, exactly as in the classic layout; the body is passed through verbatim.
+ */
+export function formatTelegramOutboundMobile(rec) {
+  const sender = rec?.event?.senderHandle || rec?.from || 'unknown';
+  const fromHandle = sender.startsWith('@') ? sender : `@${sender}`;
+  const rawBody = unescapeLiteralNewlinesForTelegram(String(rec?.event?.body ?? rec?.body ?? ''));
+  const metadata = rec?.event?.metadata && typeof rec.event.metadata === 'object' ? rec.event.metadata : {};
+  const founder = isFounderNotificationEligible(rec);
+  const deliveryType = String(rec?.evaluatedDeliveryType || 'UNKNOWN');
+  const kind = deliveryType === 'ACTION_REQUIRED' ? 'Action required' : (deliveryType === 'CC_CONTEXT' ? 'FYI' : deliveryType);
+  const toVal = outboundToFromBroker(rec);
+  const when = pktStamp(rec?.event?.createdAt ?? rec?.receivedAt);
+  const subject = String(metadata.subject ?? '').replace(/\s+/g, ' ').trim();
+  const action = metadata.actionRequired == null ? '' : String(metadata.actionRequired).trim();
+  const actionIsNone = action === '' || /^(none|unknown)\b/i.test(action);
+  const status = metadata.status == null ? '' : String(metadata.status).trim();
+  const refs = metadata.references ?? (rec?.event?.replyTo ? [`room-event:${rec.event.replyTo}`] : null);
+  const refText = Array.isArray(refs) ? refs.map(String).join(', ') : (refs == null ? '' : String(refs));
+
+  const out = [];
+  if (founder) out.push(`🚨 ${unicodeBold('ACTION FOR YOU')}`, '━━━━━━━━━━━━━━━━━━━━');
+  out.push(subject ? unicodeBold(subject) : unicodeBold('(no subject)'));
+  out.push(`#${rec?.brokerSequence ?? '?'} · ${fromHandle}${toVal ? ` → ${toVal}` : ''}`);
+  out.push([when, kind].filter(Boolean).join(' · '));
+  if (!actionIsNone) {
+    out.push('');
+    out.push(founder ? `👉 ${unicodeBold('Your action:')} ${action}` : `▸ Action: ${action}`);
+  }
+  if (rawBody.trim() !== '') { out.push('', '━━━━━━━━━━', '', rawBody.replace(/\s+$/, '')); }
+  const footer = [status && `Status: ${status}`, refText && refText !== 'NONE' && `Ref: ${refText}`, metadata.blocker != null && `Blocker: ${metadata.blocker}`, metadata.nextStep != null && `Next: ${metadata.nextStep}`].filter(Boolean);
+  if (footer.length) out.push('', '──────────', ...footer);
+  return out.join('\n');
+}
