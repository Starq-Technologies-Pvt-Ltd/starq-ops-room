+// Mirror pacing: Telegram throttles bursts to one chat. A 429 means the message
+// was NOT accepted, so waiting retry_after and sending again cannot duplicate.
+export async function sendWithTelegramBackoff(send, params, {
+  sleep = (ms) => new Promise((r) => setTimeout(r, ms)), maxAttempts = 4, maxWaitSeconds = 60, log: logFn = () => {},
+} = {}) {
+  let res;
+  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
+    res = await send(params);
+    const retryAfter = Number(res?.parameters?.retry_after);
+    if (res?.ok || res?.error_code !== 429 || !Number.isFinite(retryAfter) || attempt === maxAttempts) return res;
+    const wait = Math.min(Math.max(retryAfter, 1), maxWaitSeconds);
+    logFn(`Telegram rate limit (429); waiting ${wait}s before retry ${attempt + 1}/${maxAttempts}`);
+    await sleep(wait * 1000);
+  }
+  return res;
+}
